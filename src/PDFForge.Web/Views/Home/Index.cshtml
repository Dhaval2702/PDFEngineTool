@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<section class="text-center mb-5">
    <h1 class="display-5 fw-bold">PDFForge</h1>
    <p class="lead text-muted">Production-ready PDF workflows for teams and professionals.</p>
</section>

<div class="row g-4">
    @foreach (var tool in Model.ToolCards)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm tool-card">
                <div class="card-body">
                    <div class="icon-pill mb-3"><i class="@tool.IconClass"></i></div>
                    <h5 class="card-title">@tool.Title</h5>
                    <p class="card-text text-muted">@tool.Description</p>
                    <a class="btn btn-primary" href="@tool.Route">Open tool</a>
                </div>
            </div>
        </div>
    }
</div>
